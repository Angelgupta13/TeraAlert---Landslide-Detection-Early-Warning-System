# SMTP Configuration for Email Alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=your-email@gmail.com

# Authority Email Contacts
AUTHORITY_EMAIL_1=ddma.himachal@nic.in
AUTHORITY_EMAIL_2=controlroom-hp@nic.in
AUTHORITY_EMAIL_3=sp-district@police.gov.in
AUTHORITY_EMAIL_4=emergency@roads.gov.in

# Risk Alert Threshold (Landslides with risk >= this level will trigger email alerts)
# Options: Minimal, Low, Medium, High, Very High
RISK_ALERT_THRESHOLD=High
